# Copy to .env (git-ignored) and adjust. npm scripts load .env automatically when it exists.
# Every value below is optional; the defaults work for local development.
# Server-side only: the browser never connects to SpacetimeDB directly (it goes through the gateway).

# --- SpacetimeDB --------------------------------------------------------------------------------
# Local Docker server started with `docker compose up -d --wait spacetimedb`.
SPACETIMEDB_URI=http://localhost:3000
# Host port published by Docker; keep SPACETIMEDB_URI in sync if changed.
SPACETIMEDB_PORT=3000
# Lowercase letters, digits and dashes only (no underscores).
SPACETIMEDB_DATABASE=accrual-docs
# Fixed demo company configured by `npm run db:bootstrap`; the backend rejects any other company.
COMPANY_ID=demo
# Gateway/worker identity tokens (created by db:bootstrap). Keep server-side; never commit.
# SPACETIMEDB_SECRETS_DIR=backend/.secrets
# Only needed if the spacetime CLI is not on PATH (Windows default: %LOCALAPPDATA%\SpacetimeDB\spacetime.exe).
# SPACETIME_BIN=

# --- File store (persistent server volume for original files and CSVs) ---------------------------
# Defaults to <repo>/data/files (git-ignored).
# FILE_STORE_DIR=

# Job policy configured by bootstrap.
JOB_LEASE_SECONDS=30
JOB_MAX_ATTEMPTS=3

# --- AI workers -------------------------------------------------------------------------------
# AI providers, Python workers only. Never expose these to the browser.
FACTORY_API_KEY=
FACTORY_MODEL_ID=
# EXTRACTION uses Bitdeer (OpenAI-compatible API). Server-side only.
BITDEER_API_KEY=
# Optional; defaults to deepseek-ai/DeepSeek-V4.1-Flash (see the Bitdeer model catalog).
BITDEER_MODEL_ID=
# Optional overrides: BITDEER_BASE_URL (default https://api-inference.bitdeer.ai/v1),
# BITDEER_STRUCTURED_MODE=json_schema|json_object (json_schema falls back automatically).
# BITDEER_TOKEN_BUDGET=60000   # hard cap on tokens per worker process (a call is about 1.7k)
DROID_EXEC_PATH=droid
MATCHING_TIMEOUT_SECONDS=120

# App behavior
PROVIDER_MODE=simulated
DEMO_MODE=true

# Local frontend container
FRONTEND_PORT=5173
