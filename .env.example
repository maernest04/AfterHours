# Copy to .env (git-ignored) and adjust. npm scripts load .env automatically when it exists.
# Every value below is optional; the defaults work for local development.
# Server-side only: the browser never connects to SpacetimeDB directly (it goes through the gateway).

# --- SpacetimeDB --------------------------------------------------------------------------------
# Local server started with `spacetime start`.
SPACETIMEDB_URI=http://localhost:3000
# Lowercase letters, digits and dashes only (no underscores).
SPACETIMEDB_DATABASE=accrual-docs
# Fixed demo company configured by `npm run db:bootstrap`; the backend rejects any other company.
COMPANY_ID=demo
# Gateway/worker identity tokens (created by db:bootstrap). Keep server-side; never commit.
# SPACETIMEDB_SECRETS_DIR=backend/.secrets
# Only needed if the spacetime CLI is not on PATH (Windows default: %LOCALAPPDATA%\SpacetimeDB\spacetime.exe).
# SPACETIME_BIN=

# --- File store (persistent server volume for original files and CSVs) ---------------------------
# Defaults to <repo>/data/files (git-ignored).
# FILE_STORE_DIR=

# --- Future phases (not used yet) -------------------------------------------------------------
# AI providers, Node worker only. Never expose these to the browser.
FACTORY_API_KEY=
FACTORY_MODEL_ID=
BITDEER_API_KEY=
BITDEER_MODEL_ID=
DROID_EXEC_PATH=droid

# App behavior
PROVIDER_MODE=simulated
DEMO_MODE=true
