{
  "name": "afterhours",
  "private": true,
  "description": "AfterHours database development shortcuts",
  "scripts": {
    "db:start": "uv run --project backend/db afterhours-db start",
    "db:stop": "uv run --project backend/db afterhours-db stop",
    "db:install": "uv sync --project backend/db && npm --prefix backend/db/spacetime/spacetimedb ci",
    "db:publish": "uv run --project backend/db afterhours-db publish",
    "db:reset": "uv run --project backend/db afterhours-db reset",
    "db:sql": "uv run --project backend/db afterhours-db sql",
    "db:bootstrap": "uv run --project backend/db afterhours-db bootstrap",
    "db:seed": "uv run --project backend/db afterhours-db seed",
    "smoke": "uv run --project backend/db afterhours-db smoke",
    "typecheck": "npm --prefix backend/db/spacetime/spacetimedb run typecheck",
    "test:sdk": "uv run --project backend/db python -m unittest discover -s backend/db/test -v"
  }
}
